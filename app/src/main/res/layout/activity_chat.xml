<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/white"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnVolver"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/arrow_back"
            android:padding="6dp"
            app:tint="@color/Texto1"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <TextView
            android:id="@+id/tvNombreChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/Texto1"/>

    </LinearLayout>

    <!-- ===== MENSAJES ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"/>

    <!-- ===== INPUT ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/white"
        android:elevation="4dp">

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/escribe_un_mensaje"
            android:textSize="14sp"
            android:background="@drawable/bg_input_outline"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:importantForAutofill="no"
            android:autofillHints=""
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnEnviar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/send_foreground"
            android:background="@drawable/bg_avatar_purple"
            android:padding="10dp"
            android:contentDescription="@string/enviar"/>

    </LinearLayout>

</LinearLayout>