<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="25dp">

            <ImageView
                android:id="@+id/btnVolver"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_gray"
                android:padding="8dp"
                android:src="@drawable/flechaizquierda"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mis Publicaciones"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/Texto1"/>

            <!-- Badge contador -->
            <TextView
                android:id="@+id/tvContadorPublicaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Filtros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/btnFiltroTodos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Todos"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/white"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnFiltroActivos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Activos"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/morado_tarjetas"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnFiltroPausados"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="Pausados"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/morado_tarjetas"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== LISTA ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMisPublicaciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="130dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <!-- ===== ESTADO VACÍO ===== -->
    <LinearLayout
        android:id="@+id/layoutVacio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/camerapro"
            android:layout_marginBottom="24dp"
            app:tint="@color/Morado_suave"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aún no tienes publicaciones"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/Texto1"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publica tu primer servicio para que los clientes te encuentren"
            android:textSize="13sp"
            android:textColor="@color/gris"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnPublicarPrimero"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Publicar mi primer servicio"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:paddingHorizontal="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

    <!-- ===== FAB nueva publicación ===== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNuevaPublicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/add"
        android:contentDescription="Nueva publicación"
        app:backgroundTint="@color/primary"
        app:tint="@color/white"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>