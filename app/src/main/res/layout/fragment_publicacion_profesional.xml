<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:importantForAutofill="no"
    tools:context=".UI.PROFESIONAL.fragments.publicacionProfesional">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:importantForAutofill="no">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_gray"
                android:padding="10dp"
                android:src="@drawable/flechaizquierda"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/nueva_publicaci_n"
                android:textColor="@color/titulos_color"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/t_tulo_del_servicio"
            android:textColor="@color/titulos_color"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/input"
            android:hint="@string/ej_instalaci_n_el_ctrica_residencial"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textCapSentences"
            android:importantForAutofill="no"
            android:autofillHints=""
            android:layout_marginBottom="20dp"/>

        <!-- Categoría -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categor_a"
            android:textColor="@color/titulos_color"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCategoria"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/input"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/selecciona_una_categor_a"
            android:textColor="@color/blanco_filtro"
            android:importantForAutofill="no"
            android:layout_marginBottom="20dp"/>

        <!-- Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/descripci_n"
            android:textColor="@color/titulos_color"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/input"
            android:gravity="top"
            android:hint="@string/describe_tu_servicio_en_detalle"
            android:padding="16dp"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:importantForAutofill="no"
            android:autofillHints=""
            android:layout_marginBottom="20dp"/>

        <!-- Precio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/precio"
            android:textColor="@color/titulos_color"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:importantForAutofill="no"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/etPrecio"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:background="@drawable/input"
                android:hint="@string/_50"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:importantForAutofill="no"
                android:autofillHints=""
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:background="@drawable/input"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/por_hora"
                android:importantForAutofill="no"
                android:textColor="@color/_1a1a1a" />
        </LinearLayout>

        <!--SECCIÓN UBICACIÓN (nueva) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ubicaci_n_del_servicio"
            android:textColor="@color/titulos_color"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Botón detectar GPS -->
        <Button
            android:id="@+id/btnDetectarUbicacion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/detectar_mi_ubicaci_n"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/morado_tarjetas"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <!-- Dirección manual (se llena solo con GPS o el usuario puede editar) -->
        <EditText
            android:id="@+id/etDireccion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/input"
            android:hint="@string/o_escribe_tu_direcci_n_manualmente"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textPostalAddress"
            android:importantForAutofill="no"
            android:autofillHints=""
            android:layout_marginBottom="4dp"/>

        <!-- Texto que muestra la dirección detectada -->
        <TextView
            android:id="@+id/tvUbicacionDetectada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/morado_tarjetas"
            android:layout_marginBottom="20dp"
            android:visibility="gone"/>

        <!-- Disponibilidad -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disponibilidadprofesional"
            android:textColor="@color/titulos_color"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="7"
            android:importantForAutofill="no"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/diaLun"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/lunes"
                android:textSize="11sp"
                android:textColor="@color/morado_tarjetas"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView
                android:id="@+id/diaMar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/martes"
                android:textSize="11sp"
                android:textColor="@color/morado_tarjetas"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView android:id="@+id/diaMie"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/miercoles"
                android:textSize="11sp"
                android:textColor="@color/morado_tarjetas"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView
                android:id="@+id/diaJue"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/jueves"
                android:textSize="11sp"
                android:textColor="@color/morado_tarjetas"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView
                android:id="@+id/diaVie"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/viernes"
                android:textSize="11sp"
                android:textColor="@color/morado_tarjetas"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView
                android:id="@+id/diaSab"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/s_bado"
                android:textSize="11sp"
                android:textColor="@color/morado_tarjetas"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView
                android:id="@+id/diaDom"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/domingo"
                android:textSize="11sp"
                android:textColor="@color/morado_tarjetas"
                android:gravity="center"
                android:background="@drawable/bg_chip_unselected"/>
        </LinearLayout>

        <!-- Foto del servicio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fotos_del_trabajo"
            android:textColor="@color/titulos_color"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <FrameLayout
            android:id="@+id/layoutFotos"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/input"
            android:layout_marginBottom="30dp"
            android:clickable="true"
            android:focusable="true"
            android:importantForAutofill="no">

            <ImageView
                android:id="@+id/ivFotoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAutofill="no"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/layoutPlaceholderFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="false"
                android:focusable="false"
                android:importantForAutofill="no">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/camerapro"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAutofill="no"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/agregar_foto"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAutofill="no"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Botón Publicar -->
        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/publicar_servicio"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>
</ScrollView>