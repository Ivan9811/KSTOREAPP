<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/white">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mis_pedidos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/Texto1"
            android:gravity="center"/>

    </LinearLayout>

    <!-- ===== FILTROS ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filtroTodos"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/todos"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/filtroPendiente"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/pendientes"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/morado_tarjetas"/>

            <TextView
                android:id="@+id/filtroAceptado"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/aceptados"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/morado_tarjetas"/>

            <TextView
                android:id="@+id/filtroCompletado"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/completados"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/morado_tarjetas"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== LISTA ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"/>

    <!-- ===== EMPTY STATE ===== -->
    <LinearLayout
        android:id="@+id/layoutVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lista"
            android:textSize="48sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_hay_pedidos_a_n"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/Texto1"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ver_solicitudes"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</LinearLayout>