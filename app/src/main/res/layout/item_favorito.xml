<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- ✅ Foto del servicio (antes era solo un ícono estático) -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp">

            <!-- Foto desde Supabase -->
            <ImageView
                android:id="@+id/ivFotoServicio"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:background="@color/Morado_suave"
                android:visibility="gone"/>

            <!-- Fallback: iniciales del servicio -->
            <LinearLayout
                android:id="@+id/layoutIconoFallback"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:background="@drawable/bg_category_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/bolt"
                    app:tint="@color/primary"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Info del servicio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloServicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/Texto1"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvNombreProfesional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/gris"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvCategoriaServicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/morado_tarjetas"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_unselected"/>

                <TextView
                    android:id="@+id/tvCalificacionServicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#FF9500"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPrecioServicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Botón eliminar favorito -->
        <ImageView
            android:id="@+id/btnEliminarFavorito"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/favorito"
            android:padding="4dp"
            app:tint="#FF3B30"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>