<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- BARRA INFERIOR anclada al fondo -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:elevation="12dp"
        android:layout_gravity="bottom">

        <Button
            android:id="@+id/btnChat"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="💬 Chat"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:backgroundTint="@color/white"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnReservar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/contratar_agendar"
            android:textSize="13sp"
            android:backgroundTint="@color/morado_tarjetas"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

    <!-- SCROLL con padding bottom para no quedar tapado por los botones -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER FOTO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/morado_opaco">

                <ImageView
                    android:id="@+id/ivFotoServicio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/arrow_back"
                    android:padding="6dp"
                    android:background="@drawable/bg_circle_gray"
                    android:layout_margin="16dp"
                    android:layout_gravity="top|start"
                    app:tint="@color/white"/>

                <ImageView
                    android:id="@+id/btnFavorito"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/favorito"
                    android:padding="6dp"
                    android:background="@drawable/bg_circle_gray"
                    android:layout_margin="16dp"
                    android:layout_gravity="top|end"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white"/>

            </FrameLayout>

            <!-- CONTENIDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Info profesional -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <TextView
                            android:id="@+id/tvIniciales"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:background="@drawable/bg_avatar_purple"/>

                        <ImageView
                            android:id="@+id/ivFotoProfesional"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/tvNombreProfesional"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/Texto1"/>

                        <TextView
                            android:id="@+id/tvCalificacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/dorado"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verificado"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_chip_selected"/>

                </LinearLayout>

                <!-- Título -->
                <TextView
                    android:id="@+id/tvTituloServicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/Texto1"
                    android:layout_marginTop="12dp"/>

                <!-- Precio -->
                <TextView
                    android:id="@+id/tvPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/morado_tarjetas"
                    android:layout_marginTop="4dp"/>

                <!-- Tags -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvCiudad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/morado_tarjetas"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"/>

                    <TextView
                        android:id="@+id/tvCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/morado_tarjetas"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_chip_unselected"/>

                </LinearLayout>

                <!-- Descripción -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/descripci_n_del_servicio"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/Texto1"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/tvDescripcionServicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/gris"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Ubicación -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ubicaci_n"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/Texto1"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnVerUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="@string/ver_ubicaci_n"
                    android:backgroundTint="@color/morado_tarjetas"
                    android:textColor="@color/white"
                    android:layout_marginBottom="10dp"/>

                <!-- MapView reemplaza al <fragment> estático -->
                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>